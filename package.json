{
  "name": "wardmap",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:wasm && npm run typecheck && vite build",
    "build:wasm": "wasm-pack build crates/wasm --target web --out-dir ../../wasm/pkg --out-name wardmap_wasm --release",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@turf/helpers": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "bz2": "^1.0.1",
    "chart.js": "^4.5.1",
    "ol": "^10.10.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "visibility-polygon": "^1.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  }
}
